[ext_resource type="Script" path="res://scripts/coyote_item.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"base:dear_cruel_gravity"
display_name = "致冷酷的重力"
rarity = &"RARE"
mechanical_text = "进入未堕状态后的前 0.06 秒，\n受到的重力降低 35%。"
